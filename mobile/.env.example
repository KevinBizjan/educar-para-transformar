# Variables públicas de la app móvil (Expo las incrusta en el build: nunca pongas secretos).
# Copiar este archivo a .env y completar solo lo que haga falta.

# URL del backend. Si no se define, usa el servicio publicado en Render.
# En desarrollo local, la IP de tu computadora en la red Wi-Fi (el celular no entiende "localhost"):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# En el emulador de Android, la computadora es 10.0.2.2:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Supabase: solo para subir comprobantes de pago a Storage (HU8).
# EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=la_clave_publishable_del_proyecto
