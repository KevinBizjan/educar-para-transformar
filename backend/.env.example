# Puerto en el que corre el servidor Express
PORT=3000

# Clave secreta para firmar y verificar tokens JWT
JWT_SECRET=tu_clave_secreta_aqui_cambiar_en_produccion

# Cadena de conexión a PostgreSQL (Supabase). Usar la del POOLER, no la directa:
# Supabase -> botón "Connect" -> "Transaction pooler" (puerto 6543). La conexión
# directa (db.xxx.supabase.co) es solo IPv6 y falla desde Railway y desde muchas redes.
# Reemplazar [YOUR-PASSWORD] por la contraseña real SIN los corchetes.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres

# Siembra automática de datos demo al iniciar el servidor (opcional: true / false)
SEED_ON_BOOT=false

# Datos para pagar por transferencia bancaria (HU7). Se muestran al padre cuando genera una factura.
# Son opcionales: sin ninguno, la app le indica que consulte los datos en la institución.
# PAGO_TITULAR=
# PAGO_BANCO=
# PAGO_CBU=
# PAGO_ALIAS=

# Supabase Storage para los comprobantes de transferencia (HU8). El bucket es PRIVADO y solo el backend lo usa.
# SUPABASE_URL: Project Settings -> API (o el botón "Connect"), por ejemplo https://TU_PROYECTO.supabase.co
# SUPABASE_SERVICE_KEY: la clave SECRETA del proyecto (Project Settings -> API Keys -> "Secret key", o "service_role").
#   Nunca la pongas en la app móvil ni en el repositorio: da acceso total al proyecto.
# SUPABASE_BUCKET: nombre del bucket (por defecto "comprobantes").
# Para comprobar la configuración:  npm run verificar:storage
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=comprobantes

# Correos automáticos con Resend (HU10): factura de fin de mes y aviso de deuda del día 20.
# RESEND_API_KEY: la clave de resend.com (API Keys). Es secreta: nunca en el repositorio ni en la app.
# MAIL_FROM: remitente. Con el de prueba (por defecto, onboarding@resend.dev) Resend solo entrega al correo de tu propia
#   cuenta; para escribirle a las familias hay que verificar un dominio y poner acá, por ejemplo,
#   "Educar para Transformar <avisos@tudominio.com>".
# MAIL_REDIRIGIR_A: modo de prueba o demostración: todos los correos van a esta casilla (el asunto indica a quién iban).
# CRON_SECRET: secreto con el que el programador diario (GitHub Actions) llama a /api/correos/ejecutar. Un texto largo al azar.
# FERIADOS: feriados separados por coma (AAAA-MM-DD) para calcular el último día hábil del mes. Sin ellos solo se saltan sábados y domingos.
# Para comprobar el envío:  npm run verificar:correo -- tu@correo.com
# RESEND_API_KEY=
# MAIL_FROM=
# MAIL_REDIRIGIR_A=
# CRON_SECRET=
# FERIADOS=2026-12-08,2026-12-25

# SSL hacia la base. Por defecto activo (Supabase lo exige). Poner "false" solo
# para una base local o la de la CI (GitHub Actions), que no usa SSL.
# DATABASE_SSL=false
