# Puerto en el que corre el servidor Express
PORT=3000

# Clave secreta para firmar y verificar tokens JWT
JWT_SECRET=tu_clave_secreta_aqui_cambiar_en_produccion

# Cadena de conexión a PostgreSQL (Supabase). En Supabase: Project Settings ->
# Database -> Connection string (modo "URI"), reemplazando [YOUR-PASSWORD] por
# la contraseña real de la base.
DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# Siembra automática de datos demo al iniciar el servidor (opcional: true / false)
SEED_ON_BOOT=false

# SSL hacia la base. Por defecto activo (Supabase lo exige). Poner "false" solo
# para una base local o la de la CI (GitHub Actions), que no usa SSL.
# DATABASE_SSL=false
